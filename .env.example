# ============================================================================
# RECIRCLE – ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and replace placeholder values before running.
# Do NOT commit .env containing real credentials to version control.
# ============================================================================

# --- Backend Server ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=mysql

# --- MySQL 8 / 9 Database Configuration ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=recircle_db
DB_USERNAME=root
DB_PASSWORD=replace_with_your_mysql_password

# --- JWT Security Configuration ---
# Must be a minimum 256-bit (32+ character) Base64 or alphanumeric secret key
JWT_SECRET=ReCircleCampusTrustSharingSecretKey2026SRMInstituteOfScienceAndTech!
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Campus Email Domain & Verification Configuration ---
CAMPUS_ALLOWED_DOMAINS=srmist.edu.in,campus.edu,edu.in
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace_with_smtp_username
MAIL_PASSWORD=replace_with_smtp_app_password
MAIL_FROM=no-reply@recircle.srmist.edu.in

# --- File Upload Storage ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# --- Frontend Configuration ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME=ReCircle
